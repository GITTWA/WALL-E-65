#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/modifiers.h>

/ {
    /* Macro per le lettere maiuscole accentate Windows */
    macros {
        /* È (Alt + 0200) - Riconosciuta da Word senza errori */
        m_e_maj: m_e_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N0>
                , <&macro_release &kp LALT>
                ;
        };

        /* À (Alt + 0192) */
        m_a_maj: m_a_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N2>
                , <&macro_release &kp LALT>
                ;
        };

        /* Ò (Alt + 0210) */
        m_o_maj: m_o_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N0>
                , <&macro_release &kp LALT>
                ;
        };

        /* Ù (Alt + 0217) */
        m_u_maj: m_u_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N7>
                , <&macro_release &kp LALT>
                ;
        };

        /* Ì (Alt + 0204) */
        m_i_maj: m_i_maj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };
    };

    behaviors {
        /* Stamp premuto normalmente = STAMP
           Stamp premuto con SHIFT = PAUSA */
        stamp_pause: stamp_pause {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PSCRN>, <&kp PAUSE_BREAK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Muto / Ins (3° tasto colonna destra):
           - Da solo = MUTO (toggle audio on/off)
           - Con SHIFT = INS */
        mute_ins: mute_ins {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C_MUTE>, <&kp INS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Tasto < >:
           - Da solo = < (con Shift = >)
           - Con Ctrl SX o DX = \
           - Con Ctrl + Shift = | */
        iso_slash: iso_slash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NON_US_BSLH>, <&kp GRAVE>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        /* Tap-Dance sul tasto ì (su Layer FN):
           - 1 tocco = Ì
           - 2 tocchi rapidi = F12 */
        td_i_f12: td_i_f12 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&m_i_maj>, <&kp F12>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* CASSAFORTE A 4 TASTI DI DESTRA:
           Shift DX (56) + AltGr (62) + FN DX (63) + Ctrl DX (64)
           Attiva il Livello 2 (Amministrazione e Bootloader) */
        combo_admin_layer {
            timeout-ms = <150>;
            key-positions = <56 62 63 64>;
            bindings = <&sl 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* LIVELLO 0: Layout Base ISO-IT */
        default_layer {
            bindings = <
                /* Fila 0 */
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC   &stamp_pause
                /* Fila 1 */
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT   &kp RBKT   &kp RET    &kp DEL
                /* Fila 2: Il 3° tasto a destra è ora mute_ins */
                &kp CLCK   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT    &kp BSLH              &mute_ins
                /* Fila 3: iso_slash gestisce <, >, \ e | */
                &kp LSHFT  &iso_slash        &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT    &kp FSLH   &kp RSHFT  &kp UP
                /* Fila 4 */
                &kp LCTRL  &mo 1     &kp LALT                      &kp SPACE                     &kp RALT  &mo 1     &kp RCTRL &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

        /* LIVELLO 1: FN Layer (Vocali maiuscole, Frecce -> Navigazione, F1-F11 + TapDance F12) */
        fn_layer {
            bindings = <
                /* Fila 0: F1-F11 + (1 tap = Ì, 2 tap = F12) */
                &trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11    &td_i_f12  &trans     &trans
                /* Fila 1: Tasto è diventa È */
                &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &m_e_maj   &trans     &trans     &trans
                /* Fila 2: Tasti ò, à, ù diventano Ò, À, Ù */
                &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &m_o_maj  &m_a_maj   &m_u_maj              &trans
                /* Fila 3 */
                &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans     &kp PG_UP
                /* Fila 4: Frecce -> Navigazione */
                &trans     &trans    &trans                        &trans                        &trans    &trans    &trans    &kp HOME   &kp PG_DN  &kp END
            >;
        };

        /* LIVELLO 2: Cassaforte di Sistema (Shift DX + AltGr + FN DX + Ctrl DX) */
        admin_layer {
            bindings = <
                /* 1-5 = Scelta Profilo Bluetooth | STAMP = Modalità Bootloader */
                &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &none &none &none &none &none &none &none &bootloader
                /* TAB = Commuta Cavo ⇄ Bluetooth | CANC = Cancella Profilo Attivo */
                &out OUT_TOG   &none        &none        &none        &none        &none        &none &none &none &none &none &none &none &none &bt BT_CLR
                /* Fila 2 */
                &none          &none        &none        &none        &none        &none        &none &none &none &none &none &none &none       &none
                /* Fila 3 */
                &none          &none        &none        &none        &none        &none        &none &none &none &none &none &none &none &none
                /* Fila 4 */
                &none          &trans       &none                                  &none                            &none &trans &none &none &none &none
            >;
        };
    };
};
