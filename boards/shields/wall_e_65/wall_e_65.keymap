#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        /* Stamp premuto normalmente = STAMP
           Stamp premuto con SHIFT = PAUSA */
        stamp_pause: stamp_pause {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PSCRN>, <&kp PAUSE_BREAK>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* CASSAFORTE A 4 TASTI:
           FN SX (59) + AltGr (62) + FN DX (63) + Ctrl DX (64)
           Attiva il Livello 2 (Amministrazione Bluetooth e ZMK Studio) */
        combo_admin_layer {
            timeout-ms = <150>;
            key-positions = <59 62 63 64>;
            bindings = <&sl 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* LIVELLO 0: Layout Base ISO-IT */
        default_layer {
            bindings = <
                /* Fila 0 */
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC   &stamp_pause
                /* Fila 1 */
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT   &kp RBKT   &kp RET    &kp DEL
                /* Fila 2 */
                &kp CLCK   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT    &kp BSLH              &kp INS
                /* Fila 3 */
                &kp LSHFT  &kp NON_US_BSLH &kp Z &kp X   &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH   &kp RSHFT  &kp UP
                /* Fila 4 */
                &kp LCTRL  &mo 1     &kp LALT                      &kp SPACE                     &kp RALT  &mo 1     &kp RCTRL &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

        /* LIVELLO 1: FN Layer (Frecce -> Navigazione, Numeri -> F1-F12, <> -> \) */
        fn_layer {
            bindings = <
                /* Fila 0: F1-F12 */
                &trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11    &kp F12    &trans     &bootloader
                /* Fila 1 */
                &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans     &trans     &trans
                /* Fila 2 */
                &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans                &trans
                /* Fila 3: GRAVE emette \ in ISO-IT (e | con Shift) */
                &trans     &kp GRAVE &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans     &kp PG_UP
                /* Fila 4: Frecce -> Navigazione */
                &trans     &trans    &trans                        &trans                        &trans    &trans    &trans    &kp HOME   &kp PG_DN  &kp END
            >;
        };

        /* LIVELLO 2: Cassaforte di Sistema (Bluetooth + ZMK Studio Unlock) */
        admin_layer {
            bindings = <
                /* ESC = Reset totale BT | 1-5 = Scelta Profilo */
                &bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &none &none &none &none &none &none &none &none
                /* TAB = Commuta Cavo ⇄ Bluetooth | INVIO = Sblocco ZMK Studio | CANC = Cancella Profilo */
                &out OUT_TOG   &none        &none        &none        &none        &none        &none &none &none &none &none &none &none &studio_unlock &bt BT_CLR
                /* Fila 2 */
                &none          &none        &none        &none        &none        &none        &none &none &none &none &none &none &none       &none
                /* Fila 3 */
                &none          &none        &none        &none        &none        &none        &none &none &none &none &none &none &none &none
                /* Fila 4 */
                &none          &trans       &none                                  &none                            &none &trans &none &none &none &none
            >;
        };
    };
};
